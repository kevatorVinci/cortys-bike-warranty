<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_order_form_customer_products" model="ir.ui.view">
        <field name="name">repair.order.form.customer.products</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="customer_product_ids" invisible="1" />
                <field name="customer_lot_ids" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('id', 'in', customer_product_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="attributes">
                <attribute name="domain">[('id', 'in', customer_lot_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
